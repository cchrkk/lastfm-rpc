# Discord User Token (self-bot - usa a tuo rischio)
DISCORD_TOKEN=

# Discord Application ID (opzionale, default: Vencord)
# APP_ID=123456789012345678

# Last.fm
LASTFM_USERNAME=
LASTFM_API_KEY=

# Custom button (opzionale, Max 2 extra buttons oltre a Last.fm + Profile)
# BUTTON_TEXT=GitHub
# BUTTON_URL=https://github.com/cchrkk

# Polling interval in seconds (default: 30)
POLL_INTERVAL=30

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
